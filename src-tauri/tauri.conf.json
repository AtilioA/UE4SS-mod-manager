{
  "productName": "UE4SS Mod Manager",
  "version": "1.2.0",
  "identifier": "com.ue4ss.modmanager",
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Cross-platform UE4SS mod manager",
    "longDescription": "A desktop app for managing UE4SS mods in Unreal Engine games on Windows, Linux, and macOS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UE4SS Mod Manager",
        "width": 950,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
